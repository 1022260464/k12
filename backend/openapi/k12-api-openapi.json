{
  "openapi": "3.0.3",
  "info": {
    "title": "K12 平台接口文档",
    "description": "K12 多智能体教学平台接口草稿。当前 CRUD 接口为内存版，便于早期联调，后续再补充完整业务逻辑和数据库实现。",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "网关服务"
    },
    {
      "url": "http://localhost:8081",
      "description": "用户与权限服务"
    },
    {
      "url": "http://localhost:8082",
      "description": "课程资源服务"
    },
    {
      "url": "http://localhost:8083",
      "description": "AI 智能体服务"
    },
    {
      "url": "http://localhost:8084",
      "description": "作业与批改服务"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "01-用户与权限服务",
      "description": "用户、角色、权限、当前登录用户相关接口"
    },
    {
      "name": "02-课程资源服务",
      "description": "课程、班级、知识点、学习任务相关接口"
    },
    {
      "name": "03-知识库与RAG服务",
      "description": "知识库、文档检索、RAG 相关接口，后续补充"
    },
    {
      "name": "04-AI智能体服务",
      "description": "教学智能体配置、编排、调用相关接口"
    },
    {
      "name": "05-多模态生成服务",
      "description": "图片、语音、视频、动画生成相关接口，后续补充"
    },
    {
      "name": "06-题库与练习服务",
      "description": "题库、练习、题目生成相关接口，后续补充"
    },
    {
      "name": "07-作业与批改服务",
      "description": "作业、提交、批改、测评相关接口"
    },
    {
      "name": "08-学情分析服务",
      "description": "学习画像、掌握度、诊断报告相关接口，后续补充"
    },
    {
      "name": "09-编程实验服务",
      "description": "代码运行、实验环境、测试用例相关接口，后续补充"
    },
    {
      "name": "10-文件与资源服务",
      "description": "文件上传、资源管理、对象存储相关接口，后续补充"
    },
    {
      "name": "11-消息通知服务",
      "description": "站内信、通知、待办相关接口，后续补充"
    },
    {
      "name": "12-系统管理服务",
      "description": "系统配置、日志、审计相关接口，后续补充"
    },
    {
      "name": "99-公共接口",
      "description": "状态检查、公共探活接口"
    }
  ],
  "paths": {
    "/api/v1/gateway/health": {
      "get": {
        "tags": [
          "99-公共接口"
        ],
        "summary": "网关状态检查",
        "security": [],
        "responses": {
          "200": {
            "description": "网关服务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDescriptorResponse"
                }
              }
            }
          }
        }
      }
    },
