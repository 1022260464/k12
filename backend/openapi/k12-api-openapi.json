  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "example": 1
        }
      }
    },
    "requestBodies": {
      "UserRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UserRequest"
            }
          }
        }
      },
      "CourseRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CourseRequest"
            },
            "example": {
              "title": "Python Basics",
              "subject": "Programming",
              "gradeLevel": "BEGINNER",
              "description": "Introductory programming course"
            }
          }
        }
      },
      "AgentRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentRequest"
            },
            "example": {
              "name": "Code Tutor Agent",
              "type": "CODE_TUTOR",
              "description": "Guide students through programming exercises"
            }
          }
        }
      },
      "HomeworkRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HomeworkRequest"
            },
            "example": {
              "courseId": 1,
              "title": "Loop Practice",
              "description": "Complete basic loop exercises",
              "status": "DRAFT"
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未认证或认证失败"
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/EmptyApiResponse"
            }
          }
        }
      },
      "OkEmpty": {
        "description": "操作成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/EmptyApiResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiResponseBase": {
        "type": "object",
        "required": [
          "success",
          "message",
          "timestamp"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EmptyApiResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "nullable": true
              }
            }
          }
        ]
      },
      "ServiceDescriptor": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "iam"
          },
          "name": {
            "type": "string",
            "example": "K12 IAM Service"
          },
          "responsibility": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ServiceDescriptorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ServiceDescriptor"
              }
            }
          }
        ]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "authorities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "ROLE_ADMIN"
            ]
          }
        }
      },
      "CurrentUserApiResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/CurrentUser"
              }
            }
          }
        ]
      },
      "UserRequest": {
        "type": "object",
        "required": [
          "username",
          "nickname",
          "roleCode"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "teacher01"
          },
          "nickname": {
            "type": "string",
            "example": "Teacher One"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "teacher01@example.com"
          },
          "roleCode": {
            "type": "string",
            "example": "ROLE_TEACHER"
          }
        }
      },
      "User": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserRequest"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64",
                "example": 1
              },
              "status": {
                "type": "string",
                "example": "ENABLED"
              },
              "updatedTime": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "UserApiResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        ]
      },
      "UserListApiResponse": {
        "allOf": [
          {
