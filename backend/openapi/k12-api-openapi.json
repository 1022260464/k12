{
  "openapi": "3.0.3",
  "info": {
    "title": "K12 平台接口文档",
    "description": "K12 多智能体教学平台第一期可调用接口。包含用户、角色权限、课程、智能体和作业 CRUD，统一通过 Gateway 和 JWT 鉴权。未实现的规划接口不进入本文件。",
    "version": "0.1.1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "网关服务"
    },
    {
      "url": "http://localhost:8081",
      "description": "用户与权限服务"
    },
    {
      "url": "http://localhost:8082",
      "description": "课程资源服务"
    },
    {
      "url": "http://localhost:8083",
      "description": "AI 智能体服务"
    },
    {
      "url": "http://localhost:8084",
      "description": "作业与批改服务"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "01-用户与权限服务",
      "description": "用户、角色、权限、当前登录用户相关接口"
    },
    {
      "name": "02-课程资源服务",
      "description": "课程、班级、知识点、学习任务相关接口"
    },
    {
      "name": "03-知识库与RAG服务",
      "description": "知识库、文档检索、RAG 相关接口，后续补充"
    },
    {
      "name": "04-AI智能体服务",
      "description": "教学智能体配置、编排、调用相关接口"
    },
    {
      "name": "05-多模态生成服务",
      "description": "图片、语音、视频、动画生成相关接口，后续补充"
    },
    {
      "name": "06-题库与练习服务",
      "description": "题库、练习、题目生成相关接口，后续补充"
    },
    {
      "name": "07-作业与批改服务",
      "description": "作业、提交、批改、测评相关接口"
    },
    {
      "name": "08-学情分析服务",
      "description": "学习画像、掌握度、诊断报告相关接口，后续补充"
    },
    {
      "name": "09-编程实验服务",
      "description": "代码运行、实验环境、测试用例相关接口，后续补充"
    },
    {
      "name": "10-文件与资源服务",
      "description": "文件上传、资源管理、对象存储相关接口，后续补充"
    },
    {
      "name": "11-消息通知服务",
      "description": "站内信、通知、待办相关接口，后续补充"
    },
    {
      "name": "12-系统管理服务",
      "description": "系统配置、日志、审计相关接口，后续补充"
    },
    {
      "name": "99-公共接口",
      "description": "状态检查、公共探活接口"
    }
  ],
  "paths": {
    "/api/v1/gateway/health": {
      "get": {
        "tags": [
          "99-公共接口"
        ],
        "summary": "网关状态检查",
        "operationId": "getGatewayHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "网关服务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDescriptorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/iam/health": {
      "get": {
        "tags": [
          "99-公共接口"
        ],
        "summary": "用户与权限服务状态检查",
        "operationId": "getIamHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "用户与权限服务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDescriptorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/iam/auth/login": {
      "post": {
        "tags": ["01-用户与权限服务"],
        "summary": "用户名密码登录并获取 JWT",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginApiResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/iam/auth/register": {
      "post": {
        "tags": ["01-用户与权限服务"],
        "summary": "注册学生账号",
        "operationId": "registerStudent",
        "description": "公开注册固定分配 ROLE_STUDENT，不能通过请求指定管理员角色。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserApiResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/iam/me": {
      "get": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "获取当前登录用户",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "当前登录用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserApiResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/iam/users": {
      "get": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "用户列表",
        "operationId": "listUsers",
        "description": "需要 ROLE_ADMIN 或 user:read 权限。",
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListApiResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "创建用户",
        "operationId": "createUser",
        "description": "需要 ROLE_ADMIN 或 user:create 权限；只有管理员可以分配 ROLE_ADMIN。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreateRequest"
              },
              "example": {
                "username": "teacher01",
                "password": "Teacher@123",
                "nickname": "Teacher One",
                "email": "teacher01@example.com",
                "roleCode": "ROLE_TEACHER"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功的用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserApiResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/iam/users/{id}": {
      "get": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "用户详情",
        "operationId": "getUser",
        "description": "需要 ROLE_ADMIN 或 user:read 权限。",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserApiResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "put": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "更新用户",
        "operationId": "updateUser",
        "description": "需要 ROLE_ADMIN 或 user:update 权限。该接口不修改密码。",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/UserUpdateRequest"
        },
        "responses": {
          "200": {
            "description": "更新后的用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserApiResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "delete": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "删除用户",
        "operationId": "deleteUser",
        "description": "需要 ROLE_ADMIN 或 user:delete 权限；不能删除当前登录账号。",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OkEmpty"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
