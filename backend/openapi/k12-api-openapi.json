                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "创建用户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRequest"
              },
              "example": {
                "username": "teacher01",
                "nickname": "Teacher One",
                "email": "teacher01@example.com",
                "roleCode": "ROLE_TEACHER"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功的用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserApiResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/iam/users/{id}": {
      "get": {
        "tags": [
          "01-用户与权限服务"
        ],
        "summary": "用户详情",
