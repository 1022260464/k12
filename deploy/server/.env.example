# Copy this file to .env and replace every change_me value before deployment.
# Use URL-safe alphanumeric passwords for *_URL values, or URL-encode special characters.
COMPOSE_PROJECT_NAME=k12-platform
TZ=Asia/Shanghai
PUBLIC_HOST=127.0.0.1

# Public ports
USER_WEB_PORT=80
ADMIN_WEB_PORT=8088
MINIO_API_PORT=9000

# Infrastructure image tags. Pin digests after the first verified deployment.
MYSQL_IMAGE=mysql:8.0.46
POSTGRES_IMAGE=pgvector/pgvector:0.8.0-pg16
REDIS_IMAGE=redis:7.4-alpine
MONGO_IMAGE=mongo:7.0-jammy
RABBITMQ_IMAGE=rabbitmq:4.2.8-management-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
NEO4J_IMAGE=neo4j:5.26-community
NACOS_IMAGE=nacos/nacos-server:v2.4.3

# MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_APP_USER=k12
MYSQL_APP_PASSWORD=change_me_mysql_app
K12_AUTH_DB_NAME=k12_auth
K12_BUSINESS_DB_NAME=k12_business

# PostgreSQL / pgvector
POSTGRES_DB=k12_rag
POSTGRES_USER=k12rag
POSTGRES_PASSWORD=change_me_pgvector

# Redis
REDIS_PASSWORD=change_me_redis

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_mongo_root
MONGO_APP_USERNAME=k12agent
MONGO_APP_PASSWORD=change_me_mongo_app
MONGO_DATABASE=k12_agent

# RabbitMQ
RABBITMQ_DEFAULT_USER=k12
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq
RABBITMQ_DEFAULT_VHOST=k12

# MinIO. MINIO_PUBLIC_ENDPOINT must be reachable by the browser.
MINIO_ROOT_USER=k12minio
MINIO_ROOT_PASSWORD=change_me_minio_secret
MINIO_BUCKET=k12-agent-artifacts
MINIO_AVATAR_BUCKET=k12-user-avatars
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_DATABASE=neo4j

# Shared application security
K12_JWT_ISSUER=k12-platform
K12_JWT_SECRET=change_me_to_a_random_secret_at_least_48_characters_long
K12_JWT_ACCESS_TOKEN_TTL=30m
K12_AGENT_INTERNAL_API_KEY=change_me_internal_api_key

# Optional Nacos. Keep false unless the optional nacos profile is started and configured.
NACOS_DISCOVERY_ENABLED=false
NACOS_CONFIG_ENABLED=false
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# Alibaba Cloud Bailian / DashScope
DASHSCOPE_API_KEY=
K12_AGENT_LLM_PROVIDER=dashscope
K12_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
K12_AGENT_LLM_MODEL=qwen-plus
K12_AGENT_TTS_ENABLED=true
K12_AGENT_TTS_MODEL=cosyvoice-v3-flash
K12_AGENT_TTS_VOICE=longanyang
K12_AGENT_RAG_ENABLED=true
K12_AGENT_EMBEDDING_PROVIDER=dashscope
K12_AGENT_EMBEDDING_MODEL=text-embedding-v4
K12_AGENT_RERANKER_PROVIDER=dashscope
K12_AGENT_RERANKER_MODEL=qwen3-rerank

# Tencent Agent Sandbox (optional; local Piston remains a separately deployed fallback)
K12_AGENT_SANDBOX_ENABLED=false
K12_AGENT_SANDBOX_PROVIDER=tencent_agsx
K12_AGENT_SANDBOX_TEMPLATE=k12-python-analysis-v1
E2B_DOMAIN=
E2B_API_KEY=

# Runtime limits
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=20.0 -Dfile.encoding=UTF-8
K12_AGENT_CODE_DAILY_LIMIT=5
K12_AGENT_RAG_DATABASE_MAX_POOL_SIZE=5
