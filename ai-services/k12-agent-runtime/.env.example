K12_AGENT_ENVIRONMENT=local
K12_AGENT_HOST=127.0.0.1
K12_AGENT_PORT=8090
K12_AGENT_LOG_LEVEL=INFO

# 配置后，Java调用内部API时必须发送X-Internal-Api-Key。
K12_AGENT_INTERNAL_API_KEY=change_me_for_local_development

K12_AGENT_RABBITMQ_ENABLED=false
K12_AGENT_RABBITMQ_URL=amqp://k12:k12_dev_only_change_me@127.0.0.1:5672/k12

# 没有隔离沙箱适配器前必须保持false。
K12_AGENT_SANDBOX_ENABLED=false

# 腾讯云Agent Sandbox兼容E2B SDK。域名按沙箱地域填写，API Key禁止提交Git。
E2B_DOMAIN=
E2B_API_KEY=
K12_AGENT_SANDBOX_TEMPLATE=k12-python-analysis-v1
