K12_AGENT_ENVIRONMENT=local
K12_AGENT_HOST=127.0.0.1
K12_AGENT_PORT=8090
K12_AGENT_LOG_LEVEL=INFO

# 千问模型通过阿里云百炼的OpenAI兼容接口接入。API Key只填写在本地.env中。
K12_AGENT_LLM_PROVIDER=dashscope
K12_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
K12_AGENT_LLM_API_KEY=
K12_AGENT_LLM_MODEL=qwen-plus
K12_AGENT_LLM_TIMEOUT_SECONDS=30
K12_AGENT_LLM_MAX_OUTPUT_TOKENS=1200
K12_AGENT_LLM_TEMPERATURE=0.2

# RAG主链路使用百炼云端模型，默认复用上面的LLM API Key。
# 若切回本地模型，将provider改为local_bge，并恢复本地BGE模型名。
K12_AGENT_RAG_ENABLED=false
K12_AGENT_EMBEDDING_PROVIDER=dashscope
K12_AGENT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
K12_AGENT_EMBEDDING_API_KEY=
K12_AGENT_EMBEDDING_MODEL=text-embedding-v4
K12_AGENT_EMBEDDING_DIMENSION=1024
K12_AGENT_EMBEDDING_TIMEOUT_SECONDS=30
K12_AGENT_EMBEDDING_DEVICE=cuda
K12_AGENT_EMBEDDING_USE_FP16=true
K12_AGENT_EMBEDDING_BATCH_SIZE=10
K12_AGENT_EMBEDDING_MAX_LENGTH=512
K12_AGENT_RERANKER_PROVIDER=dashscope
K12_AGENT_RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
K12_AGENT_RERANKER_API_KEY=
K12_AGENT_RERANKER_MODEL=qwen3-rerank
K12_AGENT_RERANKER_TIMEOUT_SECONDS=30
K12_AGENT_RERANKER_INSTRUCTION=Given a K12 education question, retrieve passages that accurately answer the query.
K12_AGENT_RERANKER_DEVICE=cuda
K12_AGENT_RERANKER_USE_FP16=true
K12_AGENT_RERANKER_BATCH_SIZE=2
K12_AGENT_RERANKER_MAX_LENGTH=512
# 留空时使用Hugging Face默认缓存目录。
K12_AGENT_MODEL_CACHE_DIR=

# PostgreSQL连接串只写本地.env。数据库中需先执行sql/001_init_pgvector.sql。
K12_AGENT_RAG_DATABASE_URL=
K12_AGENT_RAG_DATABASE_MIN_POOL_SIZE=1
K12_AGENT_RAG_DATABASE_MAX_POOL_SIZE=5
K12_AGENT_RAG_CANDIDATE_COUNT=20
K12_AGENT_RAG_TOP_K=5
K12_AGENT_RAG_CHUNK_SIZE=800
K12_AGENT_RAG_CHUNK_OVERLAP=120

# Redis只用于缓存和热点数据，不作为业务真相源。
K12_AGENT_REDIS_ENABLED=false
K12_AGENT_REDIS_URL=
K12_AGENT_REDIS_KEY_PREFIX=k12:agent-runtime
K12_AGENT_REDIS_CONNECT_TIMEOUT_SECONDS=3
K12_AGENT_RAG_CACHE_TTL_SECONDS=300

# MongoDB保存Agent执行轨迹。账号、密码和连接串只填写在本地.env。
K12_AGENT_MONGODB_ENABLED=false
K12_AGENT_MONGODB_URL=
K12_AGENT_MONGODB_DATABASE=k12_agent
K12_AGENT_MONGODB_TRACE_COLLECTION=agent_run_trace
K12_AGENT_MONGODB_CONNECT_TIMEOUT_MS=3000
K12_AGENT_MONGODB_TRACE_RETENTION_DAYS=30

# MinIO保存图片、音视频、PPT和Word等大文件。
K12_AGENT_MINIO_ENABLED=false
K12_AGENT_MINIO_ENDPOINT=127.0.0.1:9000
K12_AGENT_MINIO_ACCESS_KEY=
K12_AGENT_MINIO_SECRET_KEY=
K12_AGENT_MINIO_SECURE=false
K12_AGENT_MINIO_BUCKET=k12-agent-artifacts
K12_AGENT_MINIO_REGION=
K12_AGENT_MINIO_CONNECT_TIMEOUT_SECONDS=5
K12_AGENT_MINIO_MAX_UPLOAD_BYTES=52428800
K12_AGENT_MINIO_PRESIGNED_TTL_SECONDS=900

# 配置后，Java调用内部API时必须发送X-Internal-Api-Key。
K12_AGENT_INTERNAL_API_KEY=change_me_for_local_development

K12_AGENT_RABBITMQ_ENABLED=false
K12_AGENT_RABBITMQ_URL=amqp://k12:k12_dev_only_change_me@127.0.0.1:5672/k12
# 以下代码队列名称通常保持默认值；Java和Python若覆盖，必须完全一致。
K12_AGENT_RABBITMQ_CODE_REQUEST_QUEUE=k12.code.execute.request
K12_AGENT_RABBITMQ_CODE_REQUEST_ROUTING_KEY=code.execute.request
K12_AGENT_RABBITMQ_CODE_RESULT_QUEUE=k12.code.execute.result
K12_AGENT_RABBITMQ_CODE_RESULT_ROUTING_KEY=code.execute.result

# 默认关闭。主执行器不可用时可显式配置Piston作为备用执行器。
K12_AGENT_SANDBOX_ENABLED=false
K12_AGENT_SANDBOX_PROVIDER=tencent_agsx
K12_AGENT_SANDBOX_FALLBACK_PROVIDER=local_piston
K12_AGENT_SANDBOX_FALLBACK_COOLDOWN_SECONDS=60
K12_AGENT_SANDBOX_TIMEOUT_SECONDS=30
K12_AGENT_SANDBOX_PROVIDER_REQUEST_TIMEOUT_SECONDS=30
K12_AGENT_SANDBOX_INSTANCE_TIMEOUT_SECONDS=120
# Per Python process and provider: concurrency 1-4, waiters 0-8, wait seconds (0, 5].
K12_AGENT_SANDBOX_MAX_CONCURRENCY=2
K12_AGENT_SANDBOX_MAX_WAITERS=4
K12_AGENT_SANDBOX_QUEUE_WAIT_SECONDS=3
K12_AGENT_SANDBOX_MAX_OUTPUT_BYTES=1048576
K12_AGENT_SANDBOX_MAX_RESULT_ITEMS=20
K12_AGENT_SANDBOX_MAX_ARTIFACTS=5
K12_AGENT_SANDBOX_MAX_ARTIFACT_BYTES=20971520

# 腾讯云Agent Sandbox兼容E2B SDK。域名按沙箱地域填写，API Key禁止提交Git。
E2B_DOMAIN=
E2B_API_KEY=
K12_AGENT_SANDBOX_TEMPLATE=k12-python-analysis-v1

# 本地断网演示时把PROVIDER显式改为local_piston，并先启动deploy/piston。
K12_AGENT_PISTON_URL=http://127.0.0.1:2000
K12_AGENT_PISTON_PYTHON_VERSION=3.12.0
K12_AGENT_PISTON_CONNECT_TIMEOUT_SECONDS=3
K12_AGENT_PISTON_RUN_TIMEOUT_MS=3000
