K12_AGENT_ENVIRONMENT=local
K12_AGENT_HOST=127.0.0.1
K12_AGENT_PORT=8090
K12_AGENT_LOG_LEVEL=INFO

# 千问模型通过阿里云百炼的OpenAI兼容接口接入。API Key只填写在本地.env中。
K12_AGENT_LLM_PROVIDER=dashscope
K12_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
K12_AGENT_LLM_API_KEY=
K12_AGENT_LLM_MODEL=qwen-plus
K12_AGENT_LLM_TIMEOUT_SECONDS=30
K12_AGENT_LLM_MAX_OUTPUT_TOKENS=1200
K12_AGENT_LLM_TEMPERATURE=0.2

# 本地BGE检索模型。首次请求时下载并加载，8GB显存建议保持以下批量大小。
K12_AGENT_RAG_ENABLED=false
K12_AGENT_EMBEDDING_MODEL=BAAI/bge-m3
K12_AGENT_EMBEDDING_DEVICE=cuda
K12_AGENT_EMBEDDING_USE_FP16=true
K12_AGENT_EMBEDDING_BATCH_SIZE=8
K12_AGENT_EMBEDDING_MAX_LENGTH=1024
K12_AGENT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
K12_AGENT_RERANKER_DEVICE=cuda
K12_AGENT_RERANKER_USE_FP16=true
K12_AGENT_RERANKER_BATCH_SIZE=4
K12_AGENT_RERANKER_MAX_LENGTH=512
# 留空时使用Hugging Face默认缓存目录。
K12_AGENT_MODEL_CACHE_DIR=

# 配置后，Java调用内部API时必须发送X-Internal-Api-Key。
K12_AGENT_INTERNAL_API_KEY=change_me_for_local_development

K12_AGENT_RABBITMQ_ENABLED=false
K12_AGENT_RABBITMQ_URL=amqp://k12:k12_dev_only_change_me@127.0.0.1:5672/k12

# 没有隔离沙箱适配器前必须保持false。
K12_AGENT_SANDBOX_ENABLED=false

# 腾讯云Agent Sandbox兼容E2B SDK。域名按沙箱地域填写，API Key禁止提交Git。
E2B_DOMAIN=
E2B_API_KEY=
K12_AGENT_SANDBOX_TEMPLATE=k12-python-analysis-v1
